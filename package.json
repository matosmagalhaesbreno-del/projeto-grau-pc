{
  "name": "grau-livre",
  "version": "2.0.0",
  "description": "Jogo de grau de moto para desktop",
  "main": "main.js",
  "private": true,
  "scripts": {
    "build": "node tools/build.mjs",
    "watch": "node tools/build.mjs --watch",
    "models": "node tools/models.mjs",
    "start": "npm run build && electron .",
    "dist:win": "electron-builder --win portable",
    "dist:mac": "electron-builder --mac dmg",
    "dist:linux": "electron-builder --linux AppImage",
    "test": "node tests/physics.test.mjs"
  },
  "build": {
    "appId": "com.graulivre.game",
    "productName": "Grau Livre",
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "css/**",
      "build/**"
    ],
    "win": {
      "target": "portable"
    }
  },
  "dependencies": {
    "@pmndrs/assets": "1.7.0",
    "n8ao": "2.1.0",
    "postprocessing": "6.39.6",
    "three": "0.187.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "gltfpack": "1.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.0.12"
  }
}